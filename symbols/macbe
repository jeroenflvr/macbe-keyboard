// Belgian keyboard layout with Mac-style key positions.
// Starts from the standard Belgian layout (be) and changes only what differs.
//
// Variants:
//   macbe          Mac keyboard where the VM/host sends the keys normally
//   macbe(swapped) VM (UTM/Parallels/VMware on a Mac) that swaps the
//                  top-left @ key with the < > key next to left Shift
//
// Each key lists its characters as [ plain, Shift, Option, Option+Shift ].

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "be(basic)"
    name[Group1] = "Belgian (Mac-style)";

    // Top-left key: @ / #
    replace key <TLDE> { type[Group1] = "TWO_LEVEL", [ at,         numbersign ] };

    // Option+(  = {     Option+Shift+(  = [
    key <AE05> { [ parenleft,  5,       braceleft,  bracketleft  ] };
    // Option+)  = }     Option+Shift+)  = ]
    key <AE11> { [ parenright, degree,  braceright, bracketright ] };

    // Option+Shift+L = |
    key <AC09> { [ l, L, notsign, bar ] };

    // Option+N = ~   (dead key like on the Mac: press Space after it)
    key <AB06> { [ n, N, dead_tilde, NoSymbol ] };

    // Option+Shift+: = \
    key <AB09> { [ colon, slash, division, backslash ] };
};

partial alphanumeric_keys
xkb_symbols "swapped" {
    include "macbe(basic)"
    name[Group1] = "Belgian (Mac-style, VM swapped keys)";

    // Top-left key (VM sends it as LSGT): @ / #
    replace key <LSGT> { type[Group1] = "TWO_LEVEL", [ at,         numbersign ] };
    // Key next to left Shift (VM sends it as TLDE): < / >
    replace key <TLDE> { type[Group1] = "FOUR_LEVEL", [ less, greater, backslash, NoSymbol ] };
};
